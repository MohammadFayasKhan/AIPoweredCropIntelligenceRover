# ==============================================================================
# SmartCropVision Production & Deployment Environment Configuration
# ==============================================================================

# Core Application Settings
PROJECT_NAME="SmartCropVision API"
ENVIRONMENT="production"         # development | testing | production
DEBUG=false
LOG_LEVEL="INFO"                 # DEBUG | INFO | WARNING | ERROR
SECRET_KEY="replace-with-secure-random-32-byte-hex-in-production"

# Network & Host Bindings
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
ALLOW_CREDENTIALS=true

# Groq Cloud Multimodal Intelligence & Semantic Validation Gateway
GROQ_API_KEY="replace-with-your-groq-api-key"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
GROQ_VISION_ENABLED=true
GROQ_VISION_TIMEOUT=6.0

# Security & Upload Guardrails
MAX_UPLOAD_SIZE_BYTES=15728640   # 15 MB
MIN_UPLOAD_SIZE_BYTES=2048       # 2 KB
MAX_IMAGE_PIXELS=16000000        # Decompression bomb guard (4000x4000 max)
MAX_IMAGE_DIMENSION=4096
MIN_IMAGE_DIMENSION=64
REQUEST_TIMEOUT_SECONDS=30.0

# Model Registry Directories & Checkpoints
MODEL_DIR="cv/models"
CONFIG_DIR="cv/configs"
TAXONOMY_PATH="cv/models/taxonomy_38.json"
PREPROCESSING_CONFIG_PATH="cv/models/preprocessing_config.json"

# Vision Model Checkpoints
SERVER_TIER1_MODEL_PATH="cv/models/efficientnetv2_s_best.pt"
EDGE_TIER1_MODEL_PATH="cv/models/mobilenet_v2_38classes_best.pth"
TIER2_PLANTDOC_MODEL_PATH="cv/models/yolo_plantdoc_best.pt"
TIER3_MODEL_PATH="cv/models/mobile_unet_best.pt"
DEFAULT_TIER1_MODEL="server"     # server | edge | ensemble

# Agro-Climatic Recommendation Artifacts
CROP_MODEL_DIR="cv/models/crop_recommender"

# Operational Inference Toggles
EXPLAINABILITY_ENABLED_DEFAULT=false  # Fast prediction path by default
CONF_THRESHOLD_SCREENING=0.50
YOLO_PLANTDOC_CONF_THRESH=0.20
YOLO_CONF_THRESH=0.15
YOLO_IOU_THRESH=0.45

# XiaoZhi AI Voice Assistant & MCP Bridge Configuration
XIAOZHI_ENABLED=true
# Obtain from https://xiaozhi.me/console/agents -> SofiaAI -> Extensions -> Custom Services -> MCP Endpoint
XIAOZHI_MCP_TOKEN="replace_with_regenerated_xiaozhi_mcp_token"
# Optional direct WebSocket URL override (defaults to wss://api.xiaozhi.me/mcp/?token=${XIAOZHI_MCP_TOKEN})
# XIAOZHI_MCP_ENDPOINT="wss://api.xiaozhi.me/mcp/?token=YOUR_TOKEN"
XIAOZHI_RECONNECT_INTERVAL_SECONDS=5

