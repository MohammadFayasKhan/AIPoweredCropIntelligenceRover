# ==============================================================================
# AI Powered Crop Intelligence Rover - Raspberry Pi 3 B+ (OV5647) Agent Config
# Copy to /etc/crop-rover-rpi/agent.env (chmod 600) on the Raspberry Pi.
# Never commit real tokens or Wi-Fi credentials to Git.
# ==============================================================================

# Backend WebSocket URL:
#   Local LAN Dev : ws://<HOST_LAN_IP>:8000/api/v1/rpi/device-ws
#   Cloud Prod    : wss://aipoweredcropintelligencerover.dpdns.org/api/v1/rpi/device-ws
# IMPORTANT: Do NOT use localhost or 127.0.0.1 here; on the Pi that points to the Pi itself.
RPI_BACKEND_WS_URL="wss://aipoweredcropintelligencerover.dpdns.org/api/v1/rpi/device-ws"

# Optional HTTP/HTTPS base URL for retry uploads (auto-derived from RPI_BACKEND_WS_URL if empty)
RPI_BACKEND_HTTP_URL=""

# Persistent Device Identity & Friendly Name
# Leave RPI_DEVICE_ID empty to auto-generate and persist in /var/lib/crop-rover-rpi/device_id
RPI_DEVICE_ID="rpi-ov5647-01"
RPI_DEVICE_NAME="AgriRover RPi 3B+ OV5647"

# Pre-shared Authentication Token (must match backend RPI_CAM_SECRET_KEY)
RPI_DEVICE_TOKEN="replace-with-shared-rpi-device-token"

# Lightweight Live Preview Settings (Pi 3 B+ optimized: 640x480 or 640x360 @ 10-15 FPS)
RPI_PREVIEW_WIDTH=640
RPI_PREVIEW_HEIGHT=480
RPI_PREVIEW_FPS=12
RPI_MIN_PREVIEW_FPS=4
RPI_JPEG_QUALITY=78

# Independent Full-Quality Still Capture Settings (OV5647 4:3 native sensor modes)
# Options: 2592x1944 (5MP full FOV), 1296x972 (binned 4:3 fast), 1920x1080 (1080p)
RPI_STILL_WIDTH=2592
RPI_STILL_HEIGHT=1944
RPI_STILL_QUALITY=92

# Heartbeat & Reconnect Policy
RPI_HEARTBEAT_INTERVAL_S=5.0
RPI_RECONNECT_BASE_S=1.5
RPI_RECONNECT_MAX_S=30.0
RPI_LOG_LEVEL="INFO"

